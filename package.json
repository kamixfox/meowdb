{
  "name": "@kx1xit/meowdb",
  "version": "0.1.0",
  "description": "The server for an account-based storage extension for TurboWarp",
  "license": "Apache-2.0",
  "author": "Kane",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "meowdb": "src/index.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "consola": "^3.4.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "quick.db": "^9.1.7"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "npm test && npm run lint && npm run format:check",
    "lint": "npx eslint .",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "test": "vitest run"
  },
  "allowScripts": {
    "bcrypt": true,
    "better-sqlite3": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "supertest": "^7.3.0",
    "vitest": "^5.0.1"
  }
}
